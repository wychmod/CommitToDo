# Public browser configuration. The publishable key is not a server secret.
VITE_CLOUDBASE_ENV_ID=env-xxxxxxxxxxxxxxxx
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISHABLE_KEY=publishable-key-from-cloudbase
VITE_AUTH_GATEWAY_URL=https://your-auth-gateway.example.com/auth-gateway

# Keep disabled until the P0/P5 provider, budget and CAPTCHA checks pass.
VITE_AUTH_PHONE_ENABLED=false
VITE_AUTH_GITHUB_ENABLED=false
