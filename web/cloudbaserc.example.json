{
  "envId": "env-xxxxxxxxxxxxxxxx",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "auth-gateway",
      "dir": "auth-gateway",
      "handler": "index.main",
      "runtime": "Nodejs18.15",
      "type": "HTTP",
      "timeout": 30,
      "memorySize": 512,
      "installDependency": true
    },
    {
      "name": "auth-risk-evaluator",
      "dir": "auth-risk-evaluator",
      "handler": "index.main",
      "runtime": "Nodejs18.15",
      "type": "Event",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "security-notification-worker",
      "dir": "security-notification-worker",
      "handler": "index.main",
      "runtime": "Nodejs18.15",
      "type": "Event",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true
    }
  ]
}
