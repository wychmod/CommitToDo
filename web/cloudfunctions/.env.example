# Server-only values. Never copy this file into Vite or commit real values.
TCB_ENV_ID=env-xxxxxxxxxxxxxxxx
AUTH_CLOUDBASE_AUTH_API_BASE_URL=https://your-env-id.api.tcloudbasegateway.com
PG_CONNECTION_STRING=<set-in-cloudbase-secret-manager>
AUTH_HMAC_PEPPER=replace-with-random-server-secret
AUTH_CHALLENGE_PEPPER=replace-with-random-server-secret
AUTH_ALLOWED_ORIGINS=https://your-web.example.com
AUTH_SMS_DAILY_BUDGET=100
AUTH_CAPTCHA_VERIFY_URL=https://captcha-provider.example/verify
AUTH_CAPTCHA_VERIFY_TOKEN=replace-with-server-secret
TENCENTCLOUD_SECRET_ID=replace-with-server-secret
TENCENTCLOUD_SECRET_KEY=replace-with-server-secret
AUTH_SMS_REGION=ap-shanghai
AUTH_SMS_SDK_APP_ID=replace-with-sms-app-id
AUTH_SMS_SIGN_NAME=replace-with-sms-sign
AUTH_SMS_TEMPLATE_ID=replace-with-sms-template
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=no-reply@example.com
SMTP_USER=replace-with-server-secret
SMTP_PASS=replace-with-server-secret
