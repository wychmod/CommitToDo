/* CommitToDo 第二端只读：全局样式。
 * 取值来自 design/tokens.css 的浅色主题，组件内不再另外造色。 */

page {
  --page: #f8f9fa;
  --panel: #ffffff;
  --inset: #f3f6f9;
  --line: #dce3eb;
  --text: #1b2432;
  --muted: #526174;
  --subtle: #637184;
  --accent: #245f9d;
  --accent-soft: #e7f1fb;
  --success: #246749;
  --success-bg: #e6f4ed;
  --warning: #7c4d06;
  --warning-bg: #fff0d2;
  --danger: #a22e47;
  --danger-bg: #fceaf0;
  --disabled: #616f81;
  --disabled-bg: #edf1f4;

  background: var(--page);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text {
  box-sizing: border-box;
}

/* ---------- 页面骨架 ---------- */

.page {
  padding: 14px 18px 28px;
}

.page-with-tab {
  padding-bottom: calc(92px + env(safe-area-inset-bottom));
}

.page-date {
  display: block;
  font-size: 12px;
  color: var(--muted);
  letter-spacing: 0.02em;
}

.page-title {
  display: block;
  margin-top: 2px;
  font-size: 27px;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.page-subtitle {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--muted);
}

.section {
  margin-top: 14px;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2px;
  margin-bottom: 6px;
}

.section-label {
  font-size: 12px;
  color: var(--muted);
  letter-spacing: 0.04em;
}

.section-count {
  font-size: 12px;
  color: var(--muted);
}

.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
}

.card-pad {
  padding: 14px;
}

.tap {
  transition: background 120ms ease;
}

.tap:active {
  background: var(--inset);
}

.muted {
  color: var(--muted);
}

.subtle {
  color: var(--subtle);
}

.strong {
  font-weight: 600;
}

/* ---------- 待办 / 提交行 ---------- */

.row {
  display: flex;
  align-items: center;
  min-height: 46px;
  padding: 9px 12px;
  border-top: 1px solid var(--line);
}

.row:first-child {
  border-top: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-size: 15px;
  line-height: 1.35;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  display: flex;
  align-items: center;
  margin-top: 2px;
  font-size: 12px;
  color: var(--muted);
  min-width: 0;
}

.row-sub-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-side {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 8px;
  font-size: 12px;
  color: var(--muted);
}

.row-date {
  font-size: 12px;
  color: var(--muted);
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 2px;
  margin-right: 6px;
  flex-shrink: 0;
}

.dot-round {
  border-radius: 50%;
}

.chevron {
  width: 7px;
  height: 7px;
  margin-left: 8px;
  border-right: 1.5px solid var(--subtle);
  border-bottom: 1.5px solid var(--subtle);
  transform: rotate(-45deg);
  flex-shrink: 0;
}

.chevron-down {
  transform: rotate(45deg);
  margin-bottom: 3px;
}

/* ---------- 标签 ---------- */

.tag {
  display: inline-flex;
  align-items: center;
  height: 20px;
  padding: 0 7px;
  border-radius: 6px;
  font-size: 11px;
  line-height: 20px;
  white-space: nowrap;
}

.tag-neutral {
  background: var(--disabled-bg);
  color: var(--disabled);
}

.tag-accent {
  background: var(--accent-soft);
  color: var(--accent);
}

.tag-warning {
  background: var(--warning-bg);
  color: var(--warning);
}

.tag-success {
  background: var(--success-bg);
  color: var(--success);
}

.tag-danger {
  background: var(--danger-bg);
  color: var(--danger);
}

/* ---------- 提示条 ---------- */

.banner {
  display: flex;
  align-items: center;
  margin-top: 10px;
  padding: 9px 12px;
  border-radius: 8px;
  font-size: 12px;
  background: var(--warning-bg);
  color: var(--warning);
}

.banner-text {
  flex: 1;
  min-width: 0;
}

.banner-action {
  margin-left: 10px;
  flex-shrink: 0;
  font-size: 12px;
  color: var(--accent);
  font-weight: 600;
}

.banner-danger {
  background: var(--danger-bg);
  color: var(--danger);
}

.meta-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8px;
  font-size: 11px;
  color: var(--subtle);
}

/* ---------- 状态 ---------- */

.state {
  padding: 56px 24px;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.state-body {
  display: block;
  margin-top: 6px;
  font-size: 13px;
  color: var(--muted);
}

.state-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 36px;
  margin-top: 16px;
  padding: 0 18px;
  border-radius: 6px;
  background: var(--accent);
  color: #ffffff;
  font-size: 14px;
}

.skeleton {
  padding: 18px 14px;
}

.skeleton-line {
  height: 12px;
  margin-top: 10px;
  border-radius: 4px;
  background: var(--inset);
}

.skeleton-line:first-child {
  margin-top: 0;
}

/* ---------- 今天 ---------- */

.group {
  margin-top: 12px;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  border-bottom: 1px solid var(--line);
}

.group-title {
  font-size: 13px;
  font-weight: 600;
}

.group-count {
  font-size: 12px;
  color: var(--muted);
}

.group-head-overdue .group-title {
  color: var(--warning);
}

.receipt {
  display: flex;
  align-items: center;
  padding: 9px 12px;
  border-top: 1px solid var(--line);
}

.receipt:first-child {
  border-top: none;
}

.receipt-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  margin-right: 8px;
  border-radius: 6px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 11px;
  font-weight: 700;
  flex-shrink: 0;
}

.receipt-voided {
  background: var(--disabled-bg);
  color: var(--disabled);
}

/* ---------- 分支树 ---------- */

.tree {
  padding: 4px 0;
}

.tree-row {
  display: flex;
  align-items: center;
  min-height: 40px;
  padding: 5px 10px;
  border-top: 1px solid var(--line);
}

.tree-row:first-child {
  border-top: none;
}

.tree-row-root .tree-name {
  font-weight: 600;
}

.tree-indent {
  flex-shrink: 0;
  width: 16px;
  height: 1px;
  background: var(--line);
  margin-right: 6px;
}

.tree-spacer {
  width: 26px;
  flex-shrink: 0;
}

.tree-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  margin-right: 4px;
  flex-shrink: 0;
}

.tree-toggle .chevron {
  margin-left: 0;
  transform: rotate(45deg);
  margin-bottom: 3px;
}

.tree-toggle-open .chevron {
  transform: rotate(-135deg);
  margin-bottom: 0;
  margin-top: 3px;
}

.tree-name {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tree-progress {
  margin-left: 8px;
  font-size: 12px;
  color: var(--muted);
  flex-shrink: 0;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 46px;
  padding: 0 14px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
  margin-top: 12px;
  font-size: 14px;
}

/* ---------- 分支详情 ---------- */

.detail-head {
  padding: 14px;
}

.detail-title {
  display: flex;
  align-items: center;
  font-size: 20px;
  font-weight: 700;
}

.detail-path {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--muted);
}

.detail-goal {
  display: block;
  margin-top: 10px;
  font-size: 14px;
  line-height: 1.55;
  color: var(--text);
}

.detail-goal-empty {
  color: var(--subtle);
}

.kv {
  display: flex;
  align-items: flex-start;
  padding: 10px 14px;
  border-top: 1px solid var(--line);
}

.kv:first-child {
  border-top: none;
}

.kv-key {
  width: 76px;
  flex-shrink: 0;
  font-size: 13px;
  color: var(--muted);
}

.kv-value {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  line-height: 1.5;
  word-break: break-all;
}

.empty-inline {
  padding: 18px 14px;
  font-size: 13px;
  color: var(--muted);
}

/* ---------- 历程 ---------- */

.filters {
  display: flex;
  margin-top: 10px;
}

.filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  height: 36px;
  padding: 0 10px;
  margin-right: 8px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel);
  font-size: 13px;
}

.filter:last-child {
  margin-right: 0;
}

.filter-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hist-card {
  margin-top: 12px;
  padding: 0;
}

.hist-legend {
  display: flex;
  flex-wrap: wrap;
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
  font-size: 11px;
  color: var(--muted);
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 14px;
}

.legend-mark {
  width: 8px;
  height: 8px;
  margin-right: 5px;
  border-radius: 50%;
  background: var(--muted);
}

.legend-diamond {
  border-radius: 1px;
  transform: rotate(45deg);
}

.legend-ring {
  background: transparent;
  border: 1.5px solid var(--muted);
}

.legend-dash {
  width: 10px;
  height: 0;
  border-top: 1.5px dashed var(--muted);
  border-radius: 0;
}

.hist-row {
  display: flex;
  align-items: stretch;
  min-height: 44px;
  border-top: 1px solid var(--line);
}

.hist-row:first-child {
  border-top: none;
}

.hist-date {
  width: 44px;
  flex-shrink: 0;
  padding-top: 12px;
  padding-left: 12px;
  font-size: 11px;
  color: var(--subtle);
}

.hist-lanes {
  position: relative;
  width: 76px;
  flex-shrink: 0;
}

.hist-rail {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1.5px;
  opacity: 0.55;
}

.hist-rail-stalled {
  width: 0;
  background: transparent !important;
  border-left: 1.5px dashed currentColor;
  opacity: 0.8;
}

.hist-node {
  position: absolute;
  top: 50%;
  width: 8px;
  height: 8px;
  margin-top: -4px;
  margin-left: -3.5px;
  border-radius: 50%;
  background: var(--accent);
}

.hist-node-milestone {
  border-radius: 1px;
  transform: rotate(45deg);
}

.hist-node-ring {
  background: var(--panel);
  border: 1.5px solid var(--accent);
}

.hist-link {
  position: absolute;
  top: 50%;
  height: 1.5px;
  margin-top: -0.75px;
  background: var(--line);
}

.hist-body {
  flex: 1;
  min-width: 0;
  padding: 9px 12px 9px 0;
}

.hist-title {
  display: block;
  font-size: 14px;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hist-sub {
  display: block;
  margin-top: 2px;
  font-size: 11px;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hist-stall {
  padding: 8px 12px;
  border-top: 1px solid var(--line);
  font-size: 11px;
  color: var(--muted);
}

/* ---------- 年轮 ---------- */

.year-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
}

.year-picker {
  display: flex;
  align-items: center;
  height: 32px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel);
  font-size: 13px;
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12px;
}

.metric {
  width: 50%;
  padding: 3px;
}

.metric-card {
  padding: 12px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
}

.metric-value {
  display: block;
  font-size: 24px;
  font-weight: 700;
  line-height: 1.1;
}

.metric-label {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--muted);
}

.months {
  display: flex;
  align-items: flex-end;
  height: 96px;
  padding: 12px;
}

.month {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  margin: 0 1px;
}

.month-bar {
  width: 100%;
  max-width: 14px;
  min-height: 2px;
  border-radius: 3px 3px 0 0;
  background: var(--accent);
}

.month-bar-empty {
  background: var(--disabled-bg);
}

.month-label {
  margin-top: 4px;
  font-size: 9px;
  color: var(--subtle);
}

.share {
  display: flex;
  align-items: center;
  padding: 10px 14px;
  border-top: 1px solid var(--line);
}

.share:first-child {
  border-top: none;
}

.share-main {
  flex: 1;
  min-width: 0;
}

.share-title {
  display: flex;
  align-items: center;
  font-size: 14px;
}

.share-bar {
  height: 4px;
  margin-top: 6px;
  border-radius: 2px;
  background: var(--inset);
  overflow: hidden;
}

.share-bar-fill {
  height: 4px;
  border-radius: 2px;
}

.share-count {
  margin-left: 10px;
  font-size: 12px;
  color: var(--muted);
  flex-shrink: 0;
}

.review {
  padding: 14px;
  font-size: 14px;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* ---------- 我的 / 徽章 / 帮助 ---------- */

.me-card {
  margin-top: 12px;
}

.me-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 14px;
  border-top: 1px solid var(--line);
}

.me-row:first-child {
  border-top: none;
}

.me-key {
  font-size: 13px;
  color: var(--muted);
}

.me-value {
  font-size: 13px;
  color: var(--text);
  max-width: 62%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-group {
  margin-top: 14px;
}

.badge-item {
  display: flex;
  align-items: flex-start;
  padding: 11px 14px;
  border-top: 1px solid var(--line);
}

.badge-item:first-child {
  border-top: none;
}

.badge-mark {
  width: 26px;
  height: 26px;
  margin-right: 10px;
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.badge-mark-empty {
  background: var(--disabled-bg);
  color: var(--disabled);
}

.badge-main {
  flex: 1;
  min-width: 0;
}

.badge-name {
  display: block;
  font-size: 14px;
}

.badge-hint {
  display: block;
  margin-top: 2px;
  font-size: 12px;
  color: var(--muted);
}

.badge-state {
  margin-left: 8px;
  flex-shrink: 0;
  font-size: 11px;
  color: var(--muted);
}

.help-section {
  padding: 13px 14px;
  border-top: 1px solid var(--line);
}

.help-section:first-child {
  border-top: none;
}

.help-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
}

.help-body {
  display: block;
  margin-top: 4px;
  font-size: 13px;
  line-height: 1.6;
  color: var(--muted);
}

/* ---------- 登录 ---------- */

.login {
  min-height: 100vh;
  padding: 56px 24px calc(40px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: var(--page);
}

.login-top {
  text-align: center;
}

.login-mark {
  width: 34px;
  height: 34px;
  margin: 0 auto 18px;
  border: 2px solid var(--text);
  border-radius: 8px;
  transform: rotate(-8deg);
  position: relative;
}

.login-mark::after {
  content: 'C';
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19px;
  font-weight: 700;
  transform: rotate(8deg);
}

.login-title {
  display: block;
  font-size: 28px;
  line-height: 1.35;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.login-highlight {
  display: inline-block;
  padding: 0 3px;
  background: var(--accent-soft);
  color: var(--accent);
}

.login-body {
  display: block;
  margin-top: 12px;
  font-size: 13px;
  line-height: 1.7;
  color: var(--muted);
}

.login-illustration {
  margin: 30px auto 0;
  width: 240px;
  padding: 22px 18px;
  border-radius: 14px;
  background: linear-gradient(180deg, #f1f6fb 0%, #ffffff 78%);
  border: 1px solid var(--line);
}

.login-line {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: var(--muted);
}

.login-note {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 34px;
  margin-right: 12px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: #fdf8e8;
  color: var(--accent);
  font-size: 15px;
  font-weight: 700;
}

.login-arrow {
  width: 26px;
  height: 1px;
  margin: 0 10px;
  border-top: 1px dashed var(--accent);
}

.login-branch {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: var(--muted);
}

.login-actions {
  padding-top: 28px;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46px;
  border-radius: 9px;
  background: var(--accent);
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
}

.login-button-disabled {
  background: var(--disabled-bg);
  color: var(--disabled);
}

.login-hint {
  display: block;
  margin-top: 14px;
  font-size: 12px;
  line-height: 1.6;
  color: var(--muted);
  text-align: center;
}

.login-hint-danger {
  color: var(--danger);
}
