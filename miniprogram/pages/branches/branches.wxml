<view class="page page-with-tab">
  <state-view wx:if="{{phase === 'loading'}}" state="loading" />
  <state-view
    wx:elif="{{phase === 'error'}}"
    state="error"
    title="{{errorTitle}}"
    body="{{errorBody}}"
    action-text="重试"
    bind:action="onRetry"
  />

  <block wx:else>
    <text class="page-title">分支树</text>
    <text class="page-subtitle">已使用 {{usage.used}} / {{usage.limit}} 条分支</text>

    <view wx:if="{{offline}}" class="banner">
      <text class="banner-text">网络不可用，显示上次内容</text>
      <text class="banner-action" bindtap="onRetry">重试</text>
    </view>

    <view wx:if="{{empty}}" class="card" style="margin-top: 14px">
      <state-view
        state="empty"
        title="还没有分支"
        body="在 Web 主端新建第一条分支后，这里会显示整棵树。"
      />
    </view>

    <block wx:else>
      <view class="tree-panel">
        <view class="tree-root tap" data-id="{{root.id}}" bindtap="onOpen">
          <view class="tree-root-mark"></view>
          <text class="tree-root-name">{{root.title}}</text>
          <view
            wx:if="{{root.hasChildren}}"
            class="tree-toggle {{root.open ? 'tree-toggle-open' : ''}}"
            data-id="{{root.id}}"
            catchtap="onToggle"
          >
            <view class="chevron"></view>
          </view>
        </view>

        <block wx:for="{{sections}}" wx:key="id" wx:for-item="section">
          <view
            class="tree-group tap"
            style="background: {{section.colorBg}}"
            data-id="{{section.id}}"
            bindtap="onToggle"
          >
            <view class="tree-group-mark" style="background: {{section.colorHex}}"></view>
            <text class="tree-group-name">{{section.title}}</text>
            <view class="tree-toggle {{section.open ? 'tree-toggle-open' : ''}}">
              <view class="chevron"></view>
            </view>
          </view>

          <block wx:if="{{section.open}}">
            <view
              wx:for="{{section.rows}}"
              wx:key="id"
              class="tree-row tap"
              data-id="{{item.id}}"
              bindtap="onOpen"
            >
              <view
                wx:if="{{item.hasChildren}}"
                class="tree-toggle tree-toggle-inline {{item.open ? 'tree-toggle-open' : ''}}"
                data-id="{{item.id}}"
                catchtap="onToggle"
              >
                <view class="chevron"></view>
              </view>
              <view wx:else class="tree-toggle-space"></view>
              <view
                wx:for="{{item.rails}}"
                wx:key="key"
                wx:for-item="rail"
                class="tree-rail tree-rail-{{rail.kind}}"
              ></view>
              <view class="dot" style="background: {{item.colorHex}}"></view>
              <text class="tree-name">{{item.title}}</text>
              <text wx:if="{{item.taskTotal > 0}}" class="tree-progress">{{item.taskDone}} / {{item.taskTotal}}</text>
              <text wx:if="{{item.status !== 'active'}}" class="tag {{item.tagClass}}">{{item.statusLabel}}</text>
              <view class="chevron"></view>
            </view>
          </block>
        </block>
      </view>

      <view class="link-row tap" bindtap="onOpenArchive">
        <text>已归档分支</text>
        <view class="row-side">
          <text wx:if="{{archivedCount > 0}}" class="muted">{{archivedCount}}</text>
          <view class="chevron"></view>
        </view>
      </view>
    </block>

    <view class="meta-line">
      <text>{{updatedAt}}</text>
      <text>只读</text>
    </view>
  </block>
</view>
