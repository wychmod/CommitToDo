<view class="login">
  <view class="login-top">
    <view class="login-lockup">
      <view class="login-mark"></view>
      <text class="login-wordmark">CommitToDo</text>
    </view>
    <view class="login-title">把每次完成，</view>
    <view class="login-title">留在<text class="login-highlight">分支</text>上。</view>
    <text class="login-body">勾选待办，完成记录就会落在对应分支。</text>

    <view class="login-illustration">
      <view class="illus-top">
        <view class="illus-note-wrap">
          <view class="illus-note">✓</view>
          <text class="illus-caption">完成待办</text>
        </view>
        <view class="illus-link"></view>
        <view class="illus-receipt">
          <view class="illus-receipt-check">✓</view>
          <text class="illus-receipt-text">已提交</text>
        </view>
      </view>

      <view class="illus-graph">
        <view class="illus-parent"></view>
        <view class="illus-split"></view>
        <view class="illus-slant illus-slant-up"></view>
        <view class="illus-slant illus-slant-down"></view>
        <view class="illus-lane illus-lane-up"></view>
        <view class="illus-lane illus-lane-down"></view>
        <view class="illus-node illus-node-prev"></view>
        <view class="illus-node illus-node-focus"></view>
        <view class="illus-node illus-node-sky"></view>
      </view>
    </view>
  </view>

  <view class="login-actions">
    <view class="login-button {{checking ? 'login-button-disabled' : ''}}" bindtap="onLogin">
      {{checking ? '正在检查登录状态…' : '登录 CommitToDo'}}
    </view>

    <text wx:if="{{expired}}" class="login-hint">登录状态已失效。重新登录后会回到刚才的页面。</text>
    <text wx:if="{{error}}" class="login-hint login-hint-danger">{{error}}</text>

    <block wx:if="{{unbound}}">
      <text class="login-hint">这个微信还没有绑定 CommitToDo 账号。先在网页端登录并完成绑定，再回到这里重试。</text>
      <text class="login-hint" bindtap="onCopyWeb">复制网页地址</text>
    </block>

    <text wx:if="{{!unbound && !expired && !error}}" class="login-hint">第二端只读：查看今天、分支、历程与年轮；写入仍回到网页主端。</text>
  </view>
</view>
