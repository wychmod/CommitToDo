<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'tab-active' : ''}}"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view class="tab-icon tab-icon-{{item.icon}}">
      <view class="glyph"></view>
    </view>
    <text class="tab-label">{{item.text}}</text>
  </view>
</view>
