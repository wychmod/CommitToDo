.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1px solid #dce3eb;
}

.tab {
  flex: 1;
  height: 56px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #526174;
}

.tab-active {
  color: #245f9d;
}

.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 24px;
  border-radius: 8px;
}

.tab-active .tab-icon {
  background: #e7f1fb;
}

.tab-label {
  margin-top: 2px;
  font-size: 10px;
  line-height: 1.2;
}

.glyph {
  position: relative;
  width: 15px;
  height: 15px;
  color: currentColor;
}

/* 今天：日历 */
.tab-icon-today .glyph {
  border: 1.5px solid currentColor;
  border-radius: 3px;
}

.tab-icon-today .glyph::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 4px;
  height: 1.5px;
  background: currentColor;
  opacity: 0.7;
}

.tab-icon-today .glyph::after {
  content: '';
  position: absolute;
  left: 3px;
  bottom: 3px;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 5px 0 0 currentColor;
}

/* 分支：分叉 */
.tab-icon-branch .glyph::before {
  content: '';
  position: absolute;
  left: 3px;
  top: 3px;
  width: 2px;
  height: 9px;
  border-radius: 1px;
  background: currentColor;
}

.tab-icon-branch .glyph::after {
  content: '';
  position: absolute;
  left: 2px;
  top: 1px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 6px 9px 0 currentColor;
}

/* 历程：时间线 */
.tab-icon-history .glyph::before {
  content: '';
  position: absolute;
  left: 6px;
  top: 1px;
  width: 1.5px;
  height: 13px;
  background: currentColor;
  opacity: 0.7;
}

.tab-icon-history .glyph::after {
  content: '';
  position: absolute;
  left: 4px;
  top: 1px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 5px 0 currentColor;
}

/* 我的：人像 */
.tab-icon-me .glyph::before {
  content: '';
  position: absolute;
  left: 4px;
  top: 1px;
  width: 7px;
  height: 7px;
  border: 1.5px solid currentColor;
  border-radius: 50%;
}

.tab-icon-me .glyph::after {
  content: '';
  position: absolute;
  left: 2px;
  bottom: 0;
  width: 11px;
  height: 6px;
  border: 1.5px solid currentColor;
  border-bottom: none;
  border-radius: 6px 6px 0 0;
}
